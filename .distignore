# Premium-only code. Directory guidelines 5 & 6 forbid shipping locked
# functionality inside the free plugin, so the WordPress.org build excludes
# these files; the free code degrades gracefully via class_exists() guards.
# The premium build (Freemius deployment) includes them.
src/Incidents/Attribution.php
src/Reports
src/Admin/ReportsPage.php
src/Notifications/Slack.php
src/Notifications/Webhook.php
templates/report-default.php

# Licensing. The directory build checks no licence and gates no feature, so it
# ships none of this code.
src/Licensing

# Translations come from translate.wordpress.org for directory plugins, so the
# build ships no .po, .mo or .pot files.
languages

# Repository files.
.wordpress-org
.distignore
.git
.github
.gitignore
.DS_Store
README.md
composer.json
composer.lock
node_modules
phpcs.xml
phpcs.xml.dist
*.zip
bin
dist
vendor
